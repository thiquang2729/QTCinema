# Backend Environment Variables

# Port cho backend server
PORT=5000

# API Configuration - KKPhim (phimapi.com - API miễn phí, không cần key)
API_BASE_URL=https://phimapi.com

# KKPhim API không yêu cầu API key
# Tài liệu: https://kkphim.com/api-document hoặc https://phimapi.com

# Firebase Configurations
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
